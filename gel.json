{
  "mode": "report",
  "guards": {
    "secret-scan": "report",
    "pinned-actions": "report",
    "workflow-permissions": "report",
    "dead-links": "report",
    "done-without-green": "report",
    "north-star": "report"
  },
  "north_star": {
    "metric": "seconds from flisk up to the first answer with a source",
    "baseline": "first measured run, 2026-11-17",
    "target": {
      "ratio": 2,
      "better": "lower"
    },
    "result": "bench/north-star.json",
    "evidence": "https://github.com/flisk-sh/.github/blob/main/docs/NORTH_STAR.md",
    "max_age_days": 30
  }
}
